<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <completion.contributor
                language="kotlin"
                implementationClass="com.dbocharov.tolgee.completion.KotlinTolgeeKeyCompletionContributor"/>
    </extensions>
    <!--
      The completion contributor only walks KtCallExpression / KtStringTemplateExpression
      PSI, which is shared between K1 and K2 modes. We don't call any Kotlin analysis
      API. Declaring both supported so the Kotlin plugin loads us in either mode
      instead of skipping us with the "not compatible with K2 mode" IDE log warning.
    -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true"/>
    </extensions>
</idea-plugin>
